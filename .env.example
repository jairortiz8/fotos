# ============================================================================
# RunFoto — variables de entorno
# ============================================================================
# Copiá este archivo como `.env` y completá los valores reales para tu entorno
# local. NUNCA commitees el .env real.
#
# Para producción (Railway) estas variables se configuran en el dashboard,
# nunca acá.
# ============================================================================

# ---- Django core ----
# Cambiá a `config.settings.prod` en producción.
DJANGO_SETTINGS_MODULE=config.settings.dev

# Generala con: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-please-generate-a-real-one

# True en dev, False SIEMPRE en prod.
DEBUG=True

# Lista separada por comas. En prod incluí el dominio público.
ALLOWED_HOSTS=localhost,127.0.0.1

# Lista separada por comas con esquema. Solo prod necesita esto en serio.
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ---- Branding (no hardcodear "RunFoto" en código) ----
SITE_NAME=RunFoto
SITE_DOMAIN=localhost:8000

# ---- Base de datos (Postgres 16 + pgvector) ----
# Local con `brew services start postgresql@16`:
#   DATABASE_URL=postgres://$(whoami)@localhost:5432/runfoto
# Con docker-compose:
#   DATABASE_URL=postgres://runfoto:runfoto@db:5432/runfoto
DATABASE_URL=postgres://runfoto:runfoto@localhost:5432/runfoto

# ---- Redis (cache + Celery broker + rate limit) ----
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ---- Cloudflare R2 (Fase 2) ----
# Setup: ver docs/runbook.md → "Setup inicial de Cloudflare R2".
# Tipo: token con permiso "Object Read & Write" sobre runfoto-dev y runfoto-prod.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=runfoto-dev
# Endpoint S3-compatible (NO el europeo). Lo da Cloudflare al crear el token.
# Formato: https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT_URL=
# Custom domain opcional para servir archivos públicos (CNAME -> R2).
R2_PUBLIC_BASE_URL=
# Tamaño máximo de upload del fotógrafo (MB).
PHOTO_UPLOAD_MAX_MB=15

# ---- Sentry (Fase 6 — vacío hasta entonces) ----
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.0

# ---- Notificaciones ----
# Hoy el único notifier es 'whatsapp_manual' (el admin copia el link a mano).
# Mañana se enchufa 'brevo' o 'resend' cambiando esta variable.
NOTIFIER_BACKEND=whatsapp_manual

# ---- i18n ----
LANGUAGE_CODE=es
TIME_ZONE=America/Guatemala

# ---- Email (Fase 6+) ----
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@runfoto.local
